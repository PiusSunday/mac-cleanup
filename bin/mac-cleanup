#!/usr/bin/env bash
# bin/mac-cleanup — Entry point: flag parsing, orchestration, and final report
set -euo pipefail

# ── Resolve lib directory ─────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

# ── Source core and utilities first ──────────────────────────────────────────
# shellcheck source=../lib/core/core.sh
source "${LIB_DIR}/core/core.sh"
# shellcheck source=../lib/core/protect.sh
source "${LIB_DIR}/core/protect.sh"
# shellcheck source=../lib/core/utils.sh
source "${LIB_DIR}/core/utils.sh"
# shellcheck source=../lib/core/preflight.sh
source "${LIB_DIR}/core/preflight.sh"

# ── Source all modules ────────────────────────────────────────────────────────
# shellcheck source=../lib/modules/system/standard.sh
source "${LIB_DIR}/modules/system/standard.sh"
# shellcheck source=../lib/modules/system/deep.sh
source "${LIB_DIR}/modules/system/deep.sh"
# shellcheck source=../lib/modules/system/orphans.sh
source "${LIB_DIR}/modules/system/orphans.sh"
# shellcheck source=../lib/modules/system/brew.sh
source "${LIB_DIR}/modules/system/brew.sh"
# shellcheck source=../lib/modules/system/snapshots.sh
source "${LIB_DIR}/modules/system/snapshots.sh"

# shellcheck source=../lib/modules/user/standard.sh
source "${LIB_DIR}/modules/user/standard.sh"
# shellcheck source=../lib/modules/user/mail.sh
source "${LIB_DIR}/modules/user/mail.sh"
# shellcheck source=../lib/modules/user/browsers.sh
source "${LIB_DIR}/modules/user/browsers.sh"
# shellcheck source=../lib/modules/user/apps.sh
source "${LIB_DIR}/modules/user/apps.sh"

# shellcheck source=../lib/modules/dev/devtools.sh
source "${LIB_DIR}/modules/dev/devtools.sh"
# shellcheck source=../lib/modules/dev/xcode.sh
source "${LIB_DIR}/modules/dev/xcode.sh"
# shellcheck source=../lib/modules/dev/devops.sh
source "${LIB_DIR}/modules/dev/devops.sh"
# shellcheck source=../lib/modules/dev/docker.sh
source "${LIB_DIR}/modules/dev/docker.sh"

# shellcheck source=../lib/optimize/optimize.sh
source "${LIB_DIR}/optimize/optimize.sh"

# ── Help output ───────────────────────────────────────────────────────────────
show_help() {
  cat <<EOF

${BOLD}mac-cleanup v${VERSION}${RESET} — macOS Developer Storage Cleanup

${BOLD}USAGE:${RESET}
  mac-cleanup [targets] [options]

${BOLD}TARGETS:${RESET}
  --system, -S       Scan crash reports, .DS_Store, Trash, dev caches
  --system-deep, -z  Deep system cleanup for rotated logs and old diagnostics
  --xcode, -x        Clean Xcode DerivedData, Archives, DeviceSupport
  --docker, -d       Clean Docker containers, images, volumes, build cache
  --devtools, -D     Clean orphaned node_modules, Rust targets, __pycache__, Gradle, Flutter
  --snapshots, -s    Delete local Time Machine snapshots
  --simulators       Delete unusable Xcode simulator runtimes and stale devices
  --purge-stale      Delete build artifacts in projects untouched for 90+ days
  --empty-trash      Empty the Trash. User data: --yes alone never reaches it.
                     Prompts unless --yes is also passed.
  --caches, -c       Clear ~/Library/Caches, Zsh, Spotify, JetBrains, and app caches
  --mail, -m         Clean old Mail downloads and recent-item metadata
  --brew, -b         Run brew cleanup and autoremove
  --optimize, -O     Run system optimizations (DNS flush, LS rebuild, SQLite vacuum)
  --all, -a          Run all cleanup targets

${BOLD}OPTIONS:${RESET}
  --dry-run, -n      Preview what would be deleted
  --yes, -y          Skip confirmation prompts and run live cleanup
  --clean-orphans    Delete orphan candidates after per-item confirmation
  --devops-reset     Run nuclear cleanup for Docker and developer ecosystems
  --include-ml-models Include HuggingFace/Ollama model caches during DevOps reset
  --include-system-caches
                     Also purge macOS service caches (~/Library/Caches/com.apple.*)
  --show-log         Print operation log and exit
  --version, -V      Print version and exit
  --verbose, -v      Show detailed logs
  --help, -h         Show this help

${BOLD}EXAMPLES:${RESET}
  mac-cleanup --all                 Preview all cleanups (dry-run by default)
  mac-cleanup --all --yes           Clean everything, no prompts (live mode)
  mac-cleanup --xcode --docker      Preview Xcode + Docker cleanup
  mac-cleanup --system              Scan system artifacts only
  mac-cleanup --devtools            Find orphaned build artifacts
  mac-cleanup --devops-reset --yes  Nuclear cleanup of dev toolchain caches
  mac-cleanup --show-log            Show deletion operation log
  mac-cleanup --simulators          Reclaim unusable Xcode simulator runtimes
  mac-cleanup --purge-stale         Remove build artifacts from dormant projects
  mac-cleanup --version             Show the current version

${YELLOW}${WARN}  Running mac-cleanup without cleanup targets defaults to a safe --all --dry-run preview.${RESET}
   If you pass cleanup targets without --dry-run, you will be prompted before
   any live deletion unless --yes is also passed.

EOF
}

show_version() {
  printf 'mac-cleanup v%s\n' "$VERSION"
}

set_default_targets() {
  TARGET_SYSTEM=true
  TARGET_XCODE=true
  TARGET_DOCKER=true
  TARGET_DEVTOOLS=true
  TARGET_SNAPSHOTS=true
  TARGET_CACHES=true
  TARGET_BREW=true
  TARGET_MAIL=true
  TARGET_SYSTEM_DEEP=true
  TARGET_OPTIMIZE=false
}

has_cleanup_target() {
  [[ "$TARGET_SYSTEM" == "true" ]] \
    || [[ "$TARGET_XCODE" == "true" ]] \
    || [[ "$TARGET_DOCKER" == "true" ]] \
    || [[ "$TARGET_DEVTOOLS" == "true" ]] \
    || [[ "$TARGET_SNAPSHOTS" == "true" ]] \
    || [[ "$TARGET_CACHES" == "true" ]] \
    || [[ "$TARGET_BREW" == "true" ]] \
    || [[ "$TARGET_MAIL" == "true" ]] \
    || [[ "$TARGET_SYSTEM_DEEP" == "true" ]] \
    || [[ "$TARGET_OPTIMIZE" == "true" ]] \
    || [[ "$DEVOPS_RESET_MODE" == "true" ]]
}

# ── Flag parsing ──────────────────────────────────────────────────────────────
parse_flags() {
  if [[ $# -eq 0 ]]; then
    DRY_RUN=true
    set_default_targets
    log::warn "No flags provided. Running --all --dry-run by default."
    return
  fi

  local explicit_dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --system|-S)
        TARGET_SYSTEM=true
        target_specified=true
        ;;
      --xcode|-x)
        TARGET_XCODE=true
        target_specified=true
        ;;
      --system-deep|-z)
        TARGET_SYSTEM_DEEP=true
        target_specified=true
        ;;
      --docker|-d)
        TARGET_DOCKER=true
        target_specified=true
        ;;
      --devtools|-D)
        TARGET_DEVTOOLS=true
        target_specified=true
        ;;
      --snapshots|-s)
        TARGET_SNAPSHOTS=true
        target_specified=true
        ;;
      --caches|-c)
        TARGET_CACHES=true
        target_specified=true
        ;;
      --mail|-m)
        TARGET_MAIL=true
        target_specified=true
        ;;
      --brew|-b)
        TARGET_BREW=true
        target_specified=true
        ;;
      --optimize|-O)
        TARGET_OPTIMIZE=true
        target_specified=true
        ;;
      --all|-a)
        TARGET_SYSTEM=true
        TARGET_XCODE=true
        TARGET_DOCKER=true
        TARGET_DEVTOOLS=true
        TARGET_SNAPSHOTS=true
        TARGET_CACHES=true
        TARGET_MAIL=true
        TARGET_SYSTEM_DEEP=true
        TARGET_BREW=true
        target_specified=true
        ;;
      --clean-orphans)
        CLEAN_ORPHANS=true
        ;;
      --devops-reset)
        DEVOPS_RESET_MODE=true
        ;;
      --include-ml-models)
        INCLUDE_ML_MODELS=true
        ;;
      --include-system-caches)
        INCLUDE_SYSTEM_CACHES=true
        ;;
      --simulators)
        TARGET_SIMULATORS=true
        TARGET_XCODE=true
        target_specified=true
        ;;
      --purge-stale)
        PURGE_STALE=true
        TARGET_DEVTOOLS=true
        target_specified=true
        ;;
      --empty-trash)
        EMPTY_TRASH=true
        TARGET_SYSTEM=true
        target_specified=true
        ;;
      --stale-days)
        shift
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
          STALE_PROJECT_DAYS="$1"
        else
          log::error "--stale-days requires a number of days"
          exit 1
        fi
        ;;
      --show-log)
        SHOW_OPERATION_LOG=true
        ;;
      --version|-V)
        SHOW_VERSION=true
        ;;
      --dry-run|-n)
        DRY_RUN=true
        explicit_dry_run=true
        ;;
      --yes|-y)
        SKIP_CONFIRM=true
        ;;
      --verbose|-v)
        VERBOSE=true
        ;;
      --help|-h)
        show_help
        exit 0
        ;;
      *)
        log::error "Unknown option: $1"
        show_help
        exit 1
        ;;
    esac
    shift
  done

  # Determine effective mode after all flags are parsed
  if [[ "$SHOW_OPERATION_LOG" == "true" ]] || [[ "$SHOW_VERSION" == "true" ]]; then
    return
  fi

  if ! has_cleanup_target; then
    set_default_targets
    DRY_RUN=true
    if [[ "$SKIP_CONFIRM" == "true" ]] && [[ "$explicit_dry_run" != "true" ]]; then
      log::warn "No cleanup target selected. Ignoring --yes and running --all --dry-run by default."
    else
      log::warn "No cleanup target selected. Running --all --dry-run by default."
    fi
    return
  fi

  if [[ "$explicit_dry_run" == "true" ]]; then
    # Explicit --dry-run — nothing to prompt
    DRY_RUN=true
  elif [[ "$SKIP_CONFIRM" == "true" ]]; then
    # --yes without --dry-run — proceed with live cleanup silently
    DRY_RUN=false
  else
    # Interactive: warn and prompt
    printf '\n%s%s  ⚠  You are about to delete files. This cannot be undone.%s\n' \
      "${BOLD}" "${YELLOW}" "${RESET}"
    printf '   Run with --dry-run first to preview what will be removed.\n'
    printf '   Continue with live cleanup? [y/N]: '
    local _confirm
    read -r _confirm
    if [[ "$_confirm" =~ ^[Yy]$ ]]; then
      DRY_RUN=false
    else
      log::info "Aborted. Re-run with --dry-run to preview safely."
      exit 0
    fi
  fi
}

# ── Print upgraded summary report ─────────────────────────────────────────────
print_report() {
  local duration="$1"
  local disk_before="$2"
  local disk_after="$3"

  local mode_label="live run"
  [[ "$DRY_RUN" == "true" ]] && mode_label="dry run"

  local bar
  bar=$(printf '━%.0s' $(seq 1 76))

  printf '\n%s%s%s%s\n' "${BOLD}" "${BLUE}" "$bar" "${RESET}"
  printf '  %s🧹 mac-cleanup v%s%s  %s·  %s  ·  %s%s\n' \
    "${BOLD}" "$VERSION" "${RESET}" "${DIM}" "$mode_label" "$(report::_duration "$duration")" "${RESET}"
  printf '%s%s%s%s\n\n' "${BOLD}" "${BLUE}" "$bar" "${RESET}"

  # Tolerate the array being entirely unset, not merely empty: under `set -u`
  # bash aborts on an unset name, and a caller that sources the libs from inside
  # a function scopes the `declare -a` there rather than globally.
  local module_count=0
  [[ -n "${MODULE_NAMES+x}" ]] && module_count=${#MODULE_NAMES[@]}
  if (( module_count == 0 )); then
    printf '  %s(no modules ran)%s\n\n' "${DIM}" "${RESET}"
    return 0
  fi

  # Rank by what each module can actually reclaim. Category grouping put the
  # System module first regardless of size; the number the user acts on is the
  # size, so that decides the order.
  local ranked
  ranked=$(report::_ranked_rows)

  local total_bytes=0 total_items=0 max_bytes=0
  local -a clean_modules=() review_modules=() skipped_modules=()

  local i
  for (( i=0; i<module_count; i++ )); do
    local projected="${MODULE_PROJECTED[$i]:-0}"
    [[ "$projected" =~ ^[0-9]+$ ]] || projected=0
    total_bytes=$(( total_bytes + projected ))
    total_items=$(( total_items + ${MODULE_ITEMS[$i]:-0} ))
    (( projected > max_bytes )) && max_bytes=$projected

    if (( projected == 0 )); then
      case "${MODULE_STATUS[$i]}" in
        review)  review_modules+=("${MODULE_NAMES[$i]}") ;;
        skipped) skipped_modules+=("${MODULE_NAMES[$i]}") ;;
        *)       clean_modules+=("${MODULE_NAMES[$i]}") ;;
      esac
    fi
  done

  # ── Ranked table ──
  printf '  %s%-22s %12s %7s%s\n' "${BOLD}" "MODULE" "RECLAIMABLE" "ITEMS" "${RESET}"

  local row
  while IFS='|' read -r _sortkey name projected items; do
    [[ -n "$name" ]] || continue
    local items_fmt="$items"
    # A module that cleans through its own tool (brew, docker) queues no paths,
    # so "0" beside a real size reads as a contradiction rather than "unknown".
    (( items == 0 )) && items_fmt="—"
    printf '  %-22s %12s %7s  %s\n' \
      "$name" "$(utils::format_bytes "$projected")" "$items_fmt" \
      "$(report::_bar "$projected" "$max_bytes")"
  done <<< "$ranked"

  local rule
  rule=$(printf '─%.0s' $(seq 1 74))
  printf '  %s\n' "$rule"
  printf '  %s%-22s %12s %7s%s\n' \
    "${BOLD}" "Total" "$(utils::format_bytes "$total_bytes")" "$total_items" "${RESET}"

  # ── Modules with nothing to do ──
  printf '\n'
  if (( ${#clean_modules[@]} > 0 )); then
    printf '  %sAlready clean%s   %s\n' "${DIM}" "${RESET}" "$(report::_join "${clean_modules[@]}")"
  fi
  if (( ${#review_modules[@]} > 0 )); then
    printf '  %sNeeds review%s    %s\n' "${DIM}" "${RESET}" "$(report::_join "${review_modules[@]}")"
  fi
  if (( ${#skipped_modules[@]} > 0 )); then
    printf '  %sUnavailable%s     %s\n' "${DIM}" "${RESET}" "$(report::_join "${skipped_modules[@]}")"
  fi
  if (( TOTAL_PROTECTED > 0 )) || (( TOTAL_DEDUPED > 0 )); then
    local skip_note="${TOTAL_PROTECTED} paths protected by policy"
    (( TOTAL_DEDUPED > 0 )) && skip_note="${skip_note}, ${TOTAL_DEDUPED} counted by another module"
    if [[ "$VERBOSE" != "true" ]]; then
      skip_note="${skip_note}  ${DIM}(--verbose to list)${RESET}"
    fi
    printf '  %sSkipped%s         %s\n' "${DIM}" "${RESET}" "$skip_note"
  fi

  # ── Opt-in wins ──
  report::_actions

  # ── Footer ──
  printf '\n'
  local free_before_fmt
  free_before_fmt=$(utils::format_bytes "$disk_before")
  if [[ "$DRY_RUN" == "true" ]]; then
    printf '  %sDisk%s            %s free  →  %s after cleanup\n' \
      "${DIM}" "${RESET}" "$free_before_fmt" "$(utils::format_bytes "$(( disk_before + total_bytes ))")"
  else
    # Show the projection next to the measured result. An estimate that misses
    # badly is exactly how the Docker over-reporting went unnoticed, so make any
    # future drift visible rather than silently printing only the outcome.
    local measured=$(( disk_after - disk_before ))
    printf '  %sDisk%s            %s free  →  %s free' \
      "${DIM}" "${RESET}" "$free_before_fmt" "$(utils::format_bytes "$disk_after")"
    if (( total_bytes > 0 )) && (( measured >= 0 )); then
      local drift=$(( total_bytes - measured ))
      local slack=$(( total_bytes / 5 ))
      if (( drift > slack )) && (( drift > 104857600 )); then
        printf '  %s(estimated %s — %s less than projected)%s' \
          "${YELLOW}" "$(utils::format_bytes "$total_bytes")" "$(utils::format_bytes "$drift")" "${RESET}"
      fi
    fi
    printf '\n'
  fi
  local tilde='~'
  printf '  %sLog%s             %s\n' "${DIM}" "${RESET}" "${LOG_FILE/#$HOME/$tilde}"

  printf '\n'
  if [[ "$DRY_RUN" == "true" ]]; then
    if (( total_bytes > 0 )); then
      printf '  %sThis was a preview. Re-run without --dry-run to reclaim %s.%s\n' \
        "${BOLD}" "$(utils::format_bytes "$total_bytes")" "${RESET}"
    else
      printf '  %sNothing to reclaim — this Mac is already clean.%s\n' "${BOLD}" "${RESET}"
    fi
  else
    printf '  %s%sReclaimed %s.%s\n' "${BOLD}" "${GREEN}" "$(utils::format_bytes "$total_bytes")" "${RESET}"
  fi
  printf '%s%s%s%s\n\n' "${BOLD}" "${BLUE}" "$bar" "${RESET}"
}

# Emit "sortkey|name|projected|items" per module with something to reclaim,
# largest first. Zero-byte modules are summarised on one line instead of taking
# a row each. sort -rn keys on the zero-padded byte count.
report::_ranked_rows() {
  [[ -n "${MODULE_NAMES+x}" ]] || return 0
  local i
  for (( i=0; i<${#MODULE_NAMES[@]}; i++ )); do
    local projected="${MODULE_PROJECTED[$i]:-0}"
    [[ "$projected" =~ ^[0-9]+$ ]] || projected=0
    (( projected > 0 )) || continue
    printf '%020d|%s|%s|%s\n' \
      "$projected" "${MODULE_NAMES[$i]}" "$projected" "${MODULE_ITEMS[$i]:-0}"
  done | sort -rn
}

# Proportional bar. Only relative size matters, so the largest module fills the
# width and everything else scales against it; anything non-zero gets at least a
# sliver so "small but present" never renders as "absent".
report::_bar() {
  local bytes="$1"
  local max="$2"
  local width=26

  (( bytes > 0 && max > 0 )) || return 0

  local filled=$(( bytes * width / max ))
  if (( filled < 1 )); then
    printf '%s▏%s' "${DIM}" "${RESET}"
    return 0
  fi

  local out=""
  local n
  for (( n=0; n<filled; n++ )); do out="${out}█"; done
  printf '%s%s%s' "${CYAN}" "$out" "${RESET}"
}

report::_join() {
  local out=""
  local item
  for item in "$@"; do
    [[ -n "$out" ]] && out="${out}, "
    out="${out}${item}"
  done
  printf '%s' "$out"
}

report::_duration() {
  local secs="${1:-0}"
  if (( secs < 60 )); then
    printf '%ss' "$secs"
  else
    printf '%dm %02ds' "$(( secs / 60 ))" "$(( secs % 60 ))"
  fi
}

# Everything found but deliberately not removed, with the command that would
# remove it. These are the largest numbers on most machines and used to be
# buried in the scroll-back.
report::_actions() {
  [[ -n "${ACTION_LABELS+x}" ]] || return 0
  local count=${#ACTION_LABELS[@]}
  (( count > 0 )) || return 0

  printf '\n  %s%sNEEDS YOUR DECISION%s\n' "${BOLD}" "${YELLOW}" "${RESET}"

  local ordered
  ordered=$(
    local i
    for (( i=0; i<count; i++ )); do
      printf '%020d|%s|%s\n' "${ACTION_BYTES[$i]}" "${ACTION_LABELS[$i]}" "${ACTION_COMMANDS[$i]}"
    done | sort -rn
  )

  while IFS='|' read -r bytes label command; do
    [[ -n "$label" ]] || continue
    # A size of zero here means "not measurable", not "nothing there" — Finder
    # will not report the size of the Trash. Rendering it as 0 B would read as
    # "no point bothering"; the label carries the item count instead.
    local size_fmt
    if (( 10#$bytes > 0 )); then
      size_fmt=$(utils::format_bytes "$((10#$bytes))")
    else
      size_fmt="size n/a"
    fi
    printf '  %s%10s%s   %s\n' "${BOLD}" "$size_fmt" "${RESET}" "$label"
    [[ -n "$command" ]] && printf '               %s%s%s\n' "${CYAN}" "$command" "${RESET}"
  done <<< "$ordered"
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
  parse_flags "$@"

  if [[ "$SHOW_VERSION" == "true" ]]; then
    show_version
    exit 0
  fi

  if [[ "$SHOW_OPERATION_LOG" == "true" ]]; then
    utils::show_operation_log
    exit 0
  fi

  utils::check_macos
  utils::load_whitelist

  # One ledger per run: every path is counted at most once, so the dry-run
  # preview and a live run report the same number.
  protect::claim_reset
  trap 'protect::claim_release' EXIT

  # Capture start time for duration tracking
  local start_time
  start_time=$(date +%s)

  # Show system context header
  utils::print_system_context

  # Live mode: show warning banner
  if [[ "$DRY_RUN" != "true" ]]; then
    printf '\n  %s%s  ⚠  LIVE MODE — files will be permanently deleted%s\n\n' \
      "${BOLD}" "${RED}" "${RESET}"
    preflight::run
  fi

  # Snapshot free space before
  local disk_before
  disk_before=$(utils::get_free_bytes)

  run_module() {
    local module_name="$1"
    local module_fn="$2"
    shift 2

    if ! "$module_fn" "$@"; then
      log::warn "Module '${module_name}' encountered an error — continuing."
    fi
  }

  # ── System ──
  # These used to run above the gating, so `mac-cleanup --docker` also swept
  # crash reports, .DS_Store, npm caches and emptied the Trash. A target flag
  # now means what it says.
  if [[ "$TARGET_SYSTEM" == "true" ]] || [[ "$TARGET_SYSTEM_DEEP" == "true" ]]; then
    log::category "System"
    [[ "$TARGET_SYSTEM" == "true" ]] && run_module "System" system::clean
    [[ "$TARGET_SYSTEM_DEEP" == "true" ]] && run_module "System Deep" system_deep::clean
    [[ "$TARGET_SYSTEM" == "true" ]] && run_module "Orphans" orphans::clean
  fi

  # ── Developer Tools ──
  if [[ "$TARGET_XCODE" == "true" ]] || [[ "$TARGET_DOCKER" == "true" ]] || [[ "$TARGET_DEVTOOLS" == "true" ]]; then
    log::category "Developer Tools"
    [[ "$TARGET_XCODE" == "true" ]]    && run_module "Xcode" xcode::clean
    [[ "$TARGET_DOCKER" == "true" ]]   && run_module "Docker" docker::clean
    [[ "$TARGET_DEVTOOLS" == "true" ]] && run_module "Developer Tools" devtools::clean
  fi

  # ── Caches & Logs ──
  if [[ "$TARGET_CACHES" == "true" ]] || [[ "$TARGET_BREW" == "true" ]] || [[ "$TARGET_MAIL" == "true" ]]; then
    log::category "Caches & Logs"
    if [[ "$TARGET_CACHES" == "true" ]]; then
      run_module "Caches" caches::clean
      run_module "Browsers" browsers::clean
      run_module "Apps" apps::clean
    fi
    [[ "$TARGET_MAIL" == "true" ]] && run_module "Mail" mail::clean
    [[ "$TARGET_BREW" == "true" ]]   && run_module "Homebrew" brew::clean
  fi

  if [[ "$DEVOPS_RESET_MODE" == "true" ]]; then
    log::category "Developer Tools"
    run_module "DevOps Reset" devops_reset::run
  fi

  # ── Storage Management ──
  if [[ "$TARGET_SNAPSHOTS" == "true" ]]; then
    log::category "Storage Management"
    run_module "Snapshots" snapshots::clean
  fi

  # ── Optimization ──
  if [[ "${TARGET_OPTIMIZE:-false}" == "true" ]]; then
    run_module "Optimize" optimize::run
  fi

  # Snapshot free space after
  local disk_after
  disk_after=$(utils::get_free_bytes)

  # Calculate duration
  local end_time
  end_time=$(date +%s)
  local duration=$(( end_time - start_time ))

  print_report "$duration" "$disk_before" "$disk_after"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
